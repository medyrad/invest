# Copy using: python3 scripts/dev_env.py (generates private local secrets).
INVEST_ENV=development
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3108,http://127.0.0.1:3108
OTP_DELIVERY_MODE=notification
PUBLIC_LAUNCH_ENABLED=false
POSTGRES_DB=invest
POSTGRES_USER=invest
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://invest:replace-with-a-random-database-password@127.0.0.1:55432/invest
WEB_PORT=3108
