# Files run inside Linux containers or WSL shells must keep LF endings, even when
# the repository is checked out on Windows.
*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
Makefile text eol=lf
*Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf
.env.example text eol=lf
.nvmrc text eol=lf
.python-version text eol=lf
